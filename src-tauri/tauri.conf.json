{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Documinter",
  "version": "2.0.0",
  "identifier": "com.altervayne.documinter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Documinter",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Florian Douay",
    "copyright": "Copyright © 2026 Florian Douay",
    "license": "Apache-2.0",
    "category": "Productivity",
    "shortDescription": "WYSIWYG documentation builder",
    "longDescription": "Documinter is a WYSIWYG documentation builder for composing rich technical documents and exporting them as self-contained HTML or paged PDF.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["mint"],
        "name": "Documint",
        "description": "Documint",
        "role": "Editor"
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
